      <sparkle:version>5</sparkle:version>
      <sparkle:shortVersionString>1.0.1</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>Quit or force quit apps right from the switcher: hover a preview and click ✕ or ⏻. The switcher stays open while the app closes.</p>]]></description>
